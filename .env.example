# Firebase web/client config — PUBLIC client identifiers, NOT a service-account secret.
# Copy to .env and fill from Firebase Console > Project settings > Your apps.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
# Optional: POST receipt images (multipart, field "image") to your own OCR endpoint; leave blank for manual-review mode.
EXPO_PUBLIC_OCR_API_URL=
