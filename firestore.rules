rules_version = '2';
// Smart Household Inventory v2.0 — cloud accounts, household isolation.
// Membership lives on the household doc (memberIds: [uid, ...]). Household-
// scoped docs carry only householdId; membership is checked via get() on the
// household doc — a doc's own fields never grant access by themselves.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hhPath(householdId) { return /databases/$(database)/documents/households/$(householdId); }
    function hhExists(householdId) { return exists(hhPath(householdId)); }
    function hhData(householdId) { return get(hhPath(householdId)).data; }
    function isHouseMember(householdId) {
      return signedIn() && hhExists(householdId)
        && hhData(householdId).memberIds is list
        && request.auth.uid in hhData(householdId).memberIds;
    }
    function isHouseOwner(householdId) {
      return signedIn() && hhExists(householdId) && hhData(householdId).ownerId == request.auth.uid;
    }
    // A valid invite = an inviteCodes doc named by the household's current
    // inviteCode that points back at this household.
    function validInvite(householdId) {
      return hhExists(householdId)
        && hhData(householdId).inviteCode is string
        && exists(/databases/$(database)/documents/inviteCodes/$(hhData(householdId).inviteCode))
        && get(/databases/$(database)/documents/inviteCodes/$(hhData(householdId).inviteCode)).data.householdId == householdId;
    }
    function isScopedCollection(collection) {
      return collection in ['inventoryItems', 'batches', 'stockMovements', 'shoppingLists', 'shoppingListItems',
                            'purchases', 'purchaseItems', 'priceHistory', 'wasteRecords', 'notifications',
                            'householdGoals', 'auditEvents'];
    }

    // Profiles: strictly owner-only.
    match /profiles/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite-code directory: any signed-in user may look a code up (needed to
    // join), signed-in users may register a code, household members may delete
    // one (code regeneration / household deletion). No updates.
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.householdId is string;
      allow delete: if isHouseMember(resource.data.householdId);
    }

    match /households/{householdId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        // Existing members may update the household (name, budget, invite
        // code, processedOps, member list) as long as ownership is unchanged.
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.ownerId == resource.data.ownerId)
        ||
        // Join branch: a non-member may change ONLY memberIds, adding
        // exactly themselves (previous members all retained, list grows by
        // exactly one), and only while a valid invite code exists.
        (!(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && validInvite(householdId))
      );

      match /members/{memberUid} {
        allow read: if signedIn() && (request.auth.uid == memberUid || isHouseMember(householdId));
        // Create is self-service only: your own doc, either because you are
        // already a member/owner of the household, or by presenting a valid
        // invite (the join flow).
        allow create: if signedIn()
                      && request.auth.uid == memberUid
                      && request.resource.data.userId == request.auth.uid
                      && (isHouseMember(householdId) || isHouseOwner(householdId) || validInvite(householdId));
        allow update: if isHouseMember(householdId);
        allow delete: if signedIn() && (request.auth.uid == memberUid || isHouseOwner(householdId));
      }
    }

    // Household-scoped top-level collections: every operation requires
    // membership of the household named by the doc's householdId field,
    // resolved with get() on the household doc.
    match /{collection}/{docId} {
      allow read: if isScopedCollection(collection) && isHouseMember(resource.data.householdId);
      allow create: if isScopedCollection(collection) && isHouseMember(request.resource.data.householdId);
      allow update: if isScopedCollection(collection)
                    && isHouseMember(resource.data.householdId)
                    && request.resource.data.householdId == resource.data.householdId;
      allow delete: if isScopedCollection(collection) && isHouseMember(resource.data.householdId);
    }
  }
}
